ANTHROPIC_API_KEY=sk-ant-...
ARBITER_DB_URL=sqlite:///./data/arbiter.db
ARBITER_ENV=dev
ARBITER_LOG_LEVEL=info

# hosted mode
# ARBITER_DB_URL=postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter
# ARBITER_ENV=prod
# ARBITER_ASYNC=1
# ARBITER_JOB_LEASE_SECONDS=300
# ARBITER_UPLOADS_DIR=/var/lib/arbiter/uploads
# ARBITER_RL_WRITE_PER_MIN=60

# observability (optional — needs `pip install 'arbiter-api[observability]'`)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=arbiter-api
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ARBITER_RELEASE=git-sha

# MCP server (optional — needs `pip install 'arbiter-api[mcp]'`; run `arbiter-api mcp`)
# ARBITER_MCP_ORG=local

# opt-in global pattern library (docs/28 §3 item 15). off | consume | contribute
# ARBITER_GLOBAL_PATTERNS=off
# ARBITER_GLOBAL_DB_URL=sqlite:///data/global_patterns.db

# persisted vector resolution memory (docs/28 §3 item 13) — on by default
# ARBITER_VECTOR_MEMORY=1
