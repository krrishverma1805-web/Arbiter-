ANTHROPIC_API_KEY=sk-ant-...
ARBITER_DB_URL=sqlite:///./data/arbiter.db
ARBITER_ENV=dev
ARBITER_LOG_LEVEL=info

# hosted mode
# ARBITER_DB_URL=postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter
